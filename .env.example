# -----------------------------
# Core server
# -----------------------------
NODE_ENV=development
PORT=5000
TZ=America/New_York
TRUST_PROXY=true

# -----------------------------
# API keys / AI
# -----------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=600
AI_LOG_RETENTION_DAYS=30

# -----------------------------
# Redis
# -----------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false

# -----------------------------
# Queue system (BullMQ)
# -----------------------------
JOB_QUEUE_ENABLED=true

# Insight generation queue
INSIGHT_QUEUE_ENABLED=true
INSIGHT_QUEUE_ATTEMPTS=3
INSIGHT_QUEUE_BACKOFF_MS=1500
INSIGHT_WORKER_CONCURRENCY=4
# Unlock endpoint waits this long before returning pending job state
INSIGHT_QUEUE_WAIT_MS=18000

# Outcome grading queue
OUTCOME_QUEUE_ENABLED=true
OUTCOME_QUEUE_ASYNC=true
OUTCOME_QUEUE_ATTEMPTS=4
OUTCOME_QUEUE_BACKOFF_MS=2000
OUTCOME_WORKER_CONCURRENCY=3

# Scoring queue
SCORING_QUEUE_ENABLED=true
SCORING_QUEUE_ATTEMPTS=3
SCORING_QUEUE_BACKOFF_MS=1500
SCORING_WORKER_CONCURRENCY=2

# -----------------------------
# Stats snapshot / scoring tuning
# -----------------------------
PLAYER_STATS_SNAPSHOT_TTL_SECONDS=21600
SCORE_BULK_BATCH_SIZE=300
SOCCER_LEAGUE_FETCH_CONCURRENCY=3
SOCCER_PROP_WATCHER_CONCURRENCY=6
PREFLIGHT_PROP_FRESH_SECONDS=300
PREFLIGHT_LINE_CACHE_TTL_SECONDS=120
ODDS_REFRESH_COOLDOWN_SECONDS=45

# -----------------------------
# Prop polling policy
#   Games are TRACKED (loaded) up to TRACK_WINDOW hours ahead, but a scheduled
#   game's props are only REFRESHED once inside REFRESH_WINDOW hours. Cadence is
#   tiered by time-to-start (far -> mid -> near -> hot); a LIVE game (by status)
#   is refreshed every cycle until it finalizes.
# -----------------------------
PROP_WATCHER_TRACK_WINDOW_HOURS=48
PROP_WATCHER_REFRESH_WINDOW_HOURS=30
PROP_WATCHER_FAR_TIER_FROM_HOURS=12
PROP_WATCHER_FAR_INTERVAL_MINUTES=360
PROP_WATCHER_MID_TIER_FROM_HOURS=6
PROP_WATCHER_MID_INTERVAL_MINUTES=180
PROP_WATCHER_NEAR_INTERVAL_MINUTES=60
PROP_WATCHER_HOT_WINDOW_MINUTES_BEFORE_START=60
PROP_WATCHER_HOT_INTERVAL_MINUTES=10
PROP_WATCHER_LIVE_INTERVAL_MINUTES=10
PROP_WATCHER_LIVE_POLL_WINDOW_HOURS=6

# -----------------------------
# Score polling policy
#   postGameSync only spends an Odds-API /scores credit when a started game
#   could be finishing. Tiered: "live" (in progress) vs "settle" (finishing).
# -----------------------------
SCORE_POLL_SETTLE_FROM_MINUTES=150
SCORE_POLL_SETTLE_TO_MINUTES=360
SCORE_POLL_SETTLE_INTERVAL_MINUTES=25
SCORE_POLL_LIVE_INTERVAL_MINUTES=90

# -----------------------------
# Cron toggles / schedules
# -----------------------------
CRON_MORNING_SCRAPER_ENABLED=true
CRON_MORNING_SCRAPER_SCHEDULE=0 7,16 * * *

CRON_PROP_WATCHER_ENABLED=true
CRON_PROP_WATCHER_SCHEDULE=*/10 * * * *

CRON_POST_GAME_SYNC_ENABLED=true
CRON_POST_GAME_SYNC_SCHEDULE=*/20 * * * *
POST_GAME_SYNC_IDLE_MIN_INTERVAL_MINUTES=60
POST_GAME_ACTIVE_LOOKAHEAD_HOURS=3
CRON_POST_GAME_CLEANUP_SCHEDULE=0 3 * * *

CRON_INJURY_REFRESH_ENABLED=false
CRON_INJURY_REFRESH_SCHEDULE=1-59/5 * * * *
INJURY_REFRESH_LOOKAHEAD_MINUTES=90
INJURY_REFRESH_STALE_MINUTES=30

# -----------------------------
# Data retention / cleanup
# -----------------------------
GRADED_RETENTION_DAYS=45
RETRY_EXHAUSTED_PRUNE_DAYS=14
